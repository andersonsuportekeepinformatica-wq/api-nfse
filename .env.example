# --- Aplicacao ---
PORT=3000
NODE_ENV=development

# Chave de API exigida no header "x-api-key" para consumir a API (uso interno da gestao publica).
# Gere um valor forte (ex: openssl rand -hex 32).
API_KEY=troque-esta-chave

# Chave mestra (32 bytes em hex = 64 caracteres) usada para cifrar certificados .pfx e senhas em repouso.
# Gere com: openssl rand -hex 32
CERT_ENCRYPTION_KEY=troque-esta-chave-de-64-caracteres-hexadecimais

# --- Banco de dados ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nfse?schema=public"

# --- Ambiente Nacional NFS-e (Serpro / Sefin Nacional / ADN) ---
# IMPORTANTE: os hosts de homologacao ("producao restrita") abaixo devem ser confirmados junto ao
# credenciamento do municipio/prestador no Sistema Nacional NFS-e (gov.br/nfse). O unico host de
# "producao restrita" publicamente documentado no momento desta implementacao e o Swagger do ADN:
#   https://adn.producaorestrita.nfse.gov.br/contribuintes/docs/index.html
#   https://adn.producaorestrita.nfse.gov.br/municipios/docs/index.html
# O host do Emissor Publico Nacional (Sefin Nacional, que recebe o POST /nfse da DPS) deve ser obtido
# na documentacao tecnica atualizada (gov.br/nfse > Biblioteca > Documentacao Tecnica) no momento do
# credenciamento. Ajuste as variaveis abaixo assim que o host oficial for confirmado.
#
# O ambiente ATIVO (qual par de URLs usar) e escolhido em runtime pelo painel/API
# (GET/POST /configuracao), nao por uma variavel fixa aqui - isso permite trocar entre
# homologacao e producao sem reiniciar o servidor. Os valores abaixo sao so os ENDERECOS de
# cada ambiente; SEFIN_AMBIENTE define apenas o valor inicial na primeira vez que o sistema roda.
# ATENCAO: os hosts de PRODUCAO abaixo (sem "producaorestrita") seguem o padrao inferido dos
# hosts de homologacao documentados, mas NAO foram confirmados em documentacao oficial publica.
# Confirme o host real de producao no credenciamento antes de usar o ambiente de producao.
SEFIN_NACIONAL_BASE_URL_HOMOLOGACAO=https://sefinnacional.producaorestrita.nfse.gov.br
SEFIN_NACIONAL_BASE_URL_PRODUCAO=https://sefinnacional.nfse.gov.br
ADN_BASE_URL_HOMOLOGACAO=https://adn.producaorestrita.nfse.gov.br
ADN_BASE_URL_PRODUCAO=https://adn.nfse.gov.br

# Ambiente inicial na primeira execucao ("homologacao" ou "producao"); depois disso, o ambiente
# ativo fica salvo no banco e e trocado pelo botao do painel, nao mais por esta variavel.
SEFIN_AMBIENTE=homologacao

# Timeout (ms) para chamadas HTTP ao Ambiente Nacional
SEFIN_NACIONAL_TIMEOUT_MS=30000
